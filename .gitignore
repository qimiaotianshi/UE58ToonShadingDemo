# ===== Unreal Engine 标准忽略规则 =====
# 编译产物
Binaries/
Build/
Intermediate/
DerivedDataCache/
Saved/
.vs/
.idea/
*.VC.db
*.VC.opendb
*.opensdf
*.sdf
*.suo

# 生成的工程文件
*.sln
*.slnx
*.xcodeproj
*.xcworkspace
*.DotSettings.user

# 编译日志 / 崩溃记录
*.log
replay_*.log

# macOS / Windows
.DS_Store
Thumbs.db

# 插件编译产物（保留插件源码）
Plugins/*/Binaries/
Plugins/*/Intermediate/

# 自动保存的资产
Saved/Autosaves/

# ===== 本地 AI 运行库（体积过大，禁止入仓）=====
# SoVITS / PyTorch / ffmpeg 等第三方运行环境，含大量 >100MB 的模型与可执行文件
# GitHub 单文件上限 100MB，此类内容请通过网盘或 Release 单独分发
Content/AI/
**/runtime/Lib/site-packages/
**/pretrained_models/
**/GPT_SoVITS/
**/*.pth
**/*.pt
**/*.ckpt
**/*.pickle
**/*.pyc
__pycache__/
**/TEMP/gradio/
